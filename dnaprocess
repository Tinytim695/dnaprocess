#!/usr/bin/env python3
import argparse,hashlib,json,os
from pathlib import Path

def txt(p):
 try: return Path(p).read_text(errors="replace").strip()
 except Exception: return None

def snap(pid):
 b=Path("/proc")/str(pid)
 if not b.exists(): raise SystemExit("PID "+str(pid)+" not found")
 try: exe=os.readlink(b/"exe")
 except Exception: exe=None
 digest=None
 if exe:
  try:
   h=hashlib.sha256()
   with open(exe,"rb") as f:
    for chunk in iter(lambda:f.read(1048576),b""): h.update(chunk)
   digest=h.hexdigest()
  except Exception: pass
 status={}
 for line in (txt(b/"status") or "").splitlines():
  if ":" in line:
   k,v=line.split(":",1)
   if k in {"Name","Uid","Gid","PPid","Threads","State"}: status[k]=v.strip()
 try: cwd=os.readlink(b/"cwd")
 except Exception: cwd=None
 try: root=os.readlink(b/"root")
 except Exception: root=None
 try: fd_count=sum(1 for _ in (b/"fd").iterdir())
 except Exception: fd_count=None
 maps=txt(b/"maps")
 cmd=txt(b/"cmdline")
 return {"pid":pid,"exe":exe,"exe_sha256":digest,"cmdline":cmd.replace("\0"," ") if cmd is not None else None,
         "status":status,"cwd":cwd,"root":root,"fd_count":fd_count,
         "map_count":len((maps or "").splitlines())}

def main():
 ap=argparse.ArgumentParser(description="DNAProcess local Linux process fingerprint")
 sub=ap.add_subparsers(dest="mode",required=True)
 s=sub.add_parser("snapshot"); s.add_argument("pid",type=int)
 d=sub.add_parser("diff"); d.add_argument("before"); d.add_argument("after")
 a=ap.parse_args()
 if a.mode=="snapshot":
  print(json.dumps(snap(a.pid),indent=2,sort_keys=True)); return
 before=json.loads(Path(a.before).read_text()); after=json.loads(Path(a.after).read_text())
 for k in sorted(set(before)|set(after)):
  if before.get(k)!=after.get(k):
   print(k+":"); print("  before:",repr(before.get(k))); print("  after :",repr(after.get(k)))

if __name__=="__main__": main()
